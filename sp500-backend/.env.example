# Gemini (required for AI agent) — never commit real keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Agent
AGENT_ENABLED=false
AGENT_INTERVAL_MINUTES=15
AGENT_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL
ALLOW_AFTER_HOURS=false

# Risk
INITIAL_BALANCE=100000
MAX_CASH_PCT_PER_BUY=0.05
MAX_OPEN_TICKERS=3
MIN_CONFIDENCE=0.65
