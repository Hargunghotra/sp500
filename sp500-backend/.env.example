# Gemini (required for AI agent) — never commit real keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Agent
AGENT_ENABLED=false
AGENT_INTERVAL_MINUTES=15
# Leave empty to screen full S&P 500; set CSV to override
AGENT_WATCHLIST=
# regular = 9:30–16:00 ET; extended = 4:00–20:00 ET (pre + regular + after)
TRADING_SESSION=extended
# true = run 24x7 including weekends (overrides TRADING_SESSION)
ALLOW_AFTER_HOURS=false

# Capital / risk (profit-max defaults; still hard-capped)
INITIAL_BALANCE=50000
MAX_CASH_PCT_PER_BUY=0.12
MAX_OPEN_TICKERS=12
MIN_CONFIDENCE=0.55
SCREEN_TOP_N=25
SCREEN_CACHE_MINUTES=30
SCREEN_BATCH_SIZE=40

# Daily digest email (Gmail SMTP + App Password)
DIGEST_ENABLED=true
DIGEST_TO=hargung123456@gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
