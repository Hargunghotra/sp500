# Gemini (required for AI agent) — never commit real keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Agent
AGENT_ENABLED=false
AGENT_INTERVAL_MINUTES=15
# Leave empty to screen full S&P 500; set CSV to override
AGENT_WATCHLIST=
# regular = 9:30–16:00 ET; extended = 4:00–20:00 ET (pre + regular + after)
TRADING_SESSION=extended
# true = run 24x7 including weekends (overrides TRADING_SESSION)
ALLOW_AFTER_HOURS=false

# Capital / risk
INITIAL_BALANCE=50000
MAX_CASH_PCT_PER_BUY=0.08
MAX_OPEN_TICKERS=10
MIN_CONFIDENCE=0.65
SCREEN_TOP_N=25
SCREEN_CACHE_MINUTES=30
SCREEN_BATCH_SIZE=40
